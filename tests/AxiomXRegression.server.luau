-- Deterministic property checks; these do not cast or create Instances per iteration.
local Randomizer = Random.new(20261105)
local AllSquaredDistancesMatch = true
local AllSegmentParametersValid = true
local AllSphereChecksMatch = true
for _ = 1, 2000 do
	local A = Vector3.new(Randomizer:NextNumber(-100, 100), Randomizer:NextNumber(-100, 100), Randomizer:NextNumber(-100, 100))
	local B = Vector3.new(Randomizer:NextNumber(-100, 100), Randomizer:NextNumber(-100, 100), Randomizer:NextNumber(-100, 100))
	local Point = Vector3.new(Randomizer:NextNumber(-100, 100), Randomizer:NextNumber(-100, 100), Randomizer:NextNumber(-100, 100))
	local Squared = AxiomX.FastDistanceSquared(A, B)
	if not near(Squared, (B - A):Dot(B - A), 1e-7) then AllSquaredDistancesMatch = false end
	local Parameter = AxiomX.FastClosestSegmentParameter(Point, A, B)
	if Parameter < 0 or Parameter > 1 or not AxiomX.IsFinite(Parameter) then AllSegmentParametersValid = false end
	local Radius = Randomizer:NextNumber(0, 300)
	if AxiomX.FastSphereContains(Point, A, Radius) ~= (AxiomX.FastDistanceSquared(Point, A) <= Radius * Radius) then AllSphereChecksMatch = false end
end
check("2000 randomized squared distances", AllSquaredDistancesMatch)
check("2000 randomized segment parameters", AllSegmentParametersValid)
check("2000 randomized sphere checks", AllSphereChecksMatch)


