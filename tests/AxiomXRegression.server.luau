check("Impact point", Hit ~= nil and near(Hit.Position.Y, 502))
check("Reflection", Hit ~= nil and vec(Hit.Reflection, Vector3.yAxis))
check("Raw raycast", AxiomX.Raycast(Above, Vector3.new(0, -30, 0), RayParams) ~= nil)
