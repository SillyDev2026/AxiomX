RayParams.IncludeInstances = {Part}
local Overlap = OverlapParams.new()
Overlap.IncludeInstances = {Part}

local Above = Part.Position + Vector3.new(0, 20, 0)
local FromSide = Part.Position + Vector3.new(20, 0, 0)
