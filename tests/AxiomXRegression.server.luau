--!strict
--!optimize 2

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
if not RunService:IsStudio() then return end
local AxiomX = require(ReplicatedStorage:WaitForChild("AxiomX"))

local Passed = 0
local Failed = 0

local function check(Name: string, Condition: boolean)
	if Condition then
		Passed += 1
	else
		Failed += 1
		warn("[AxiomX] FAIL:", Name)
	end
end

local function near(A: number, B: number, Tolerance: number?): boolean
	return math.abs(A - B) <= (Tolerance or 1e-5)
end

local function vec(A: Vector3, B: Vector3, Tolerance: number?): boolean
	return (A - B).Magnitude <= (Tolerance or 1e-5)
end

check("Version", AxiomX.Version == "1.0.0")
